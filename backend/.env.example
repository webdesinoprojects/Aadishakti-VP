PORT=5000
HOST=0.0.0.0
TRUST_PROXY=1
ADMIN_USERNAME=admin@aadishakti
ADMIN_PASSWORD=admin123
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=your-super-secret-admin-jwt-key-min-64-characters-long-random-string
ADMIN_JWT_EXPIRY=8h
ADMIN_COOKIE_NAME=admin_token
ADMIN_COOKIE_SECURE=false
ADMIN_COOKIE_SAME_SITE=lax
JWT_SECRET=your-super-secret-jwt-key-min-64-characters-long-random-string-here
JWT_EXPIRY=8h
FRONTEND_URL=http://localhost:5173

# Supabase Postgres + Auth (backend only)
# Keep SUPABASE_ENABLED=false until the migration is applied and the first admin profile exists.
SUPABASE_ENABLED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# One-time `npm run db:bootstrap-admin` values (remove the password after use)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_DISPLAY_NAME=Administrator
INITIAL_ADMIN_ROLE=super_admin

# ImageKit media library (private key stays on the backend)
IMAGEKIT_ENABLED=false
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_UPLOAD_FOLDER=/aadishakti

# Current CIS JWT API (backend only; no business-response cache)
CIS_API_BASE_URL=
CIS_REQUEST_TIMEOUT_MS=30000
CIS_RETRY_ATTEMPTS=1
CIS_RETRY_DELAY_MS=1000
CIS_TOKEN_EXPIRY_SKEW_MS=60000
CIS_RESOURCE_CACHE_TTL_MS=120000
CIS_RESOURCE_CACHE_STALE_MS=900000
CIS_RESOURCE_CACHE_MAX_ENTRIES=50
CIS_AGRPL_USERNAME=
CIS_AGRPL_PASSWORD=
CIS_AM_USERNAME=
CIS_AM_PASSWORD=
CIS_AMRPL_USERNAME=
CIS_AMRPL_PASSWORD=

# Temporary Phase 1 portal accounts (backend only; replace with real secrets locally)
PORTAL_SESSION_SECRET=
PORTAL_SESSION_TTL_MINUTES=480
PORTAL_COOKIE_NAME=portal_session
PORTAL_COOKIE_SAME_SITE=lax
PORTAL_COOKIE_SECURE=false
PORTAL_CUSTOMER_LOGIN_ID=
PORTAL_CUSTOMER_LOGIN_PASSWORD=
PORTAL_CUSTOMER_SAP_CARD_CODE=
PORTAL_CUSTOMER_CIS_COMPANY_CODE=
PORTAL_CUSTOMER_DISPLAY_NAME=
PORTAL_VENDOR_LOGIN_ID=
PORTAL_VENDOR_LOGIN_PASSWORD=
PORTAL_VENDOR_SAP_CARD_CODE=
PORTAL_VENDOR_CIS_COMPANY_CODE=
PORTAL_VENDOR_DISPLAY_NAME=

# Instructions:
# 1. Copy this file to .env
# 2. Set your plain text password in ADMIN_PASSWORD
# 3. Password will be hashed automatically at runtime
# 4. Generate a random JWT_SECRET (64+ characters recommended)
